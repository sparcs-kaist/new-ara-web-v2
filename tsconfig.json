{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@sparcs-kaist/keyboard-inset": ["packages/keyboard-inset/src/index.ts"],
      "@sparcs-kaist/keyboard-inset/react": ["packages/keyboard-inset/src/react.ts"]
    }
  },
  "include": ["declarations.d.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next.config.js"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "packages/*/dist",
    "packages/*/test",
    "packages/*/tsup.config.ts",
    "packages/*/vitest.config.ts"
  ]
}
